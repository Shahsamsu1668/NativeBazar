# ==============================================================================
# Amar Haat (NativeBazar) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite - exposed to client bundle)
# ------------------------------------------------------------------------------

# Cloud API Base URL:
# Set this when deploying the frontend to GitHub Pages, Vercel, or Netlify and
# connecting to a remote cloud-hosted backend (e.g., Render, Railway, Fly.io).
# If left blank on static hosts (like GitHub Pages), the app automatically falls
# back to full client-side mock authentication and local database storage.
# Example: https://amar-haat-api.onrender.com
VITE_API_BASE_URL=""

# Optional: Gemini API Key for client-side AI advisory & market analysis
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Free Image Search API Keys (for dynamic crop photo fetching)
# If left blank, the app uses open zero-key Wikimedia/Wikipedia image APIs & high-res category imagery.
VITE_UNSPLASH_ACCESS_KEY=""
VITE_PEXELS_API_KEY=""
VITE_GOOGLE_SEARCH_API_KEY=""
VITE_GOOGLE_SEARCH_CX=""

# Optional backend image API keys:
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER ENVIRONMENT VARIABLES (Node.js Express & Database)
# ------------------------------------------------------------------------------

# Port for the Node.js Express server (default: 3000)
PORT=3000

# Server host binding (default: 0.0.0.0 for LAN and container access)
HOST=0.0.0.0

# Gemini API Key for server-side AI endpoints
GEMINI_API_KEY="your_gemini_api_key_here"

# Public URL where the application is accessible
APP_URL="http://localhost:3000"

# CORS Allowed Origins (comma-separated, or * for open dev/test access)
# Example: https://yourusername.github.io,http://localhost:3000,http://localhost:5173
CORS_ORIGIN="*"

# ------------------------------------------------------------------------------
# 3. OPTIONAL CLOUD DATABASE INTEGRATIONS (Supabase / MongoDB / Firebase / PostgreSQL)
# ------------------------------------------------------------------------------
# If migrating from local SQLite (nativebazar.db) to cloud-hosted databases:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
# MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/nativebazar?retryWrites=true&w=majority"
# FIREBASE_PROJECT_ID="nativebazar-live"
